# Voxora Phase 2 environment examples
# Copy to .env locally. Never commit real secrets.

NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081

DATABASE_URL=postgresql://voxora:voxora@127.0.0.1:5432/voxora?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=dev-only-change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OWNER_BOOTSTRAP_EMAIL=luna35moonlight@gmail.com
# One-time Owner bootstrap secret (min 16 chars). Never ship in client/mobile config.
# After successful bootstrap, DB completion record blocks reuse even if this env var remains set.
OWNER_BOOTSTRAP_TOKEN=

# EmailDeliveryProvider: none = NOT_CONFIGURED; dev = isolated capture (not production send)
EMAIL_PROVIDER=none
# PhoneVerificationProvider: none = NOT_CONFIGURED; dev = isolated OTP capture
PHONE_PROVIDER=none

# Encrypts MFA TOTP secrets at rest (AES-256-GCM). Min 32 chars.
MFA_ENCRYPTION_KEY=

# Store billing readiness (do not invent product IDs until configured)
APPLE_IAP_CONFIGURED=false
GOOGLE_PLAY_BILLING_CONFIGURED=false

EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
