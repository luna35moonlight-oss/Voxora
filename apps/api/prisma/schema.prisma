generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  USER
  SUPPORT
  MODERATOR
  ADMIN
  OWNER
  SERVICE_ACCOUNT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_DELETION
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  emailVerifiedAt  DateTime?
  passwordHash     String
  status           UserStatus        @default(ACTIVE)
  mfaEnabled       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  identities       AuthIdentity[]
  sessions         Session[]
  roleAssignments  RoleAssignment[]
  verificationRecords VerificationRecord[]
  auditEvents      AuditEvent[]      @relation("AuditActor")
  mfaFactors       MfaFactor[]
  avatarOwnerships UserAvatarOwnership[]
  avatarItemOwnerships UserAvatarItemOwnership[]
  avatarSelections UserAvatarSelection[]
  avatarEquipment  UserAvatarEquipment[]
}

model AuthIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  type       String
  provider   String?
  subject    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  deviceLabel      String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  assignments RoleAssignment[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedBy String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, roleId])
}

model VerificationRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  channel      String
  purpose      String
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tokenHash])
}

model MfaFactor {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  secretEnc  String?
  enabled    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rulesJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  subject   String?
  payload   Json?
  ipHash    String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId])
}

model AvatarCatalogue {
  id                    String   @id
  displayName           String
  tier                  String
  rarity                String
  rigFamily             String
  riveAssetRef          String
  thumbnailRef          String
  entitlementCapability String?
  packageKey            String?
  active                Boolean  @default(true)
  version               Int      @default(1)
  performanceProfile    String   @default("STANDARD")
  fallbackAvatarId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ownerships            UserAvatarOwnership[]
  selections            UserAvatarSelection[]
  equipment             UserAvatarEquipment[]

  @@index([active, tier])
  @@index([rigFamily])
}

model AvatarAsset {
  id                 String   @id
  assetType          String
  version            Int      @default(1)
  rigFamily          String
  avatarId           String?
  itemId             String?
  slot               String?
  storageRef         String
  thumbnailRef       String?
  performanceProfile String   @default("STANDARD")
  fallbackAssetId    String?
  metadataJson       Json?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([assetType, active])
  @@index([rigFamily])
}

model AvatarItem {
  id                    String   @id
  displayName           String
  slot                  String
  rarity                String
  rigFamily             String
  assetRef              String
  thumbnailRef          String
  entitlementCapability String?
  packageKey            String?
  conflictsJson         Json?
  active                Boolean  @default(true)
  version               Int      @default(1)
  performanceProfile    String   @default("STANDARD")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  ownerships            UserAvatarItemOwnership[]
  equipment             UserAvatarEquipment[]

  @@index([slot, active])
  @@index([rigFamily])
}

model UserAvatarOwnership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  avatarId    String
  source      String
  sourceRef   String?
  grantedBy   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar      AvatarCatalogue @relation(fields: [avatarId], references: [id], onDelete: Restrict)

  @@unique([userId, avatarId])
  @@index([source])
}

model UserAvatarItemOwnership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  itemId      String
  source      String
  sourceRef   String?
  grantedBy   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        AvatarItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, itemId])
  @@index([source])
}

model UserAvatarSelection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  avatarId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar    AvatarCatalogue @relation(fields: [avatarId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@index([avatarId])
}

model UserAvatarEquipment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  avatarId  String
  itemId    String
  slot      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar    AvatarCatalogue @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  item      AvatarItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, avatarId, slot])
  @@index([itemId])
}

/// Singleton durable record proving Owner bootstrap completed.
/// Key is always "owner_bootstrap". Survives restarts; bootstrap cannot reuse env token after this exists.
model OwnerBootstrapCompletion {
  id          String   @id
  ownerUserId String   @db.Uuid
  completedAt DateTime
  createdAt   DateTime @default(now())
}
